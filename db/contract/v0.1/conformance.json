{
  "contract": "GiaDB",
  "version": "0.1.0",
  "scenarios": [
    {
      "id": "body.unchanged",
      "input": {
        "bodies": [
          "",
          "# Title\n\nParagraph\n",
          "{\"ok\":true}",
          "<!-- note -->"
        ]
      },
      "expect": {
        "bodies": [
          "",
          "# Title\n\nParagraph\n",
          "{\"ok\":true}",
          "<!-- note -->"
        ]
      }
    },
    {
      "id": "issue.any_body",
      "input": {
        "number": 4,
        "body": "",
        "labels": ["bug", "docs"]
      },
      "expect": { "kind": "resource", "body": "" }
    },
    {
      "id": "labels.do_not_change_body",
      "input": {
        "id": 21,
        "body": "Primary",
        "before": ["docs", "custom"],
        "labels": ["personal"]
      },
      "expect": {
        "id": 21,
        "body": "Primary",
        "labels": ["personal"]
      }
    },
    {
      "id": "mutation.pull_request_rejected",
      "input": {
        "number": 8,
        "pull_request": {},
        "operation": "update"
      },
      "expect": { "error": "not_found", "mutated": false }
    },
    {
      "id": "list.pull_request",
      "input": {
        "number": 7,
        "pull_request": {},
        "body": "not a resource"
      },
      "expect": { "kind": "non_resource" }
    },
    {
      "id": "list.empty_filtered_page_continues",
      "input": {
        "items": [{ "number": 8, "pull_request": {}, "body": "not a resource" }],
        "next_token": "opaque-next"
      },
      "expect": {
        "item_count": 0,
        "exhausted": false,
        "next_token": "opaque-next"
      }
    },
    {
      "id": "list.state_default",
      "input": {
        "resources": [
          { "id": 41, "state": "active" },
          { "id": 42, "state": "forgotten" }
        ]
      },
      "expect": { "ids": [41] }
    },
    {
      "id": "list.state_active",
      "input": {
        "state": "active",
        "resources": [
          { "id": 41, "state": "active" },
          { "id": 42, "state": "forgotten" }
        ]
      },
      "expect": { "ids": [41] }
    },
    {
      "id": "list.state_forgotten",
      "input": {
        "state": "forgotten",
        "resources": [
          { "id": 41, "state": "active" },
          { "id": 42, "state": "forgotten" }
        ]
      },
      "expect": { "ids": [42] }
    },
    {
      "id": "sections.are_separate",
      "input": { "resource": 12, "comment_count": 3 },
      "expect": { "resource_has_sections": false }
    },
    {
      "id": "list.title_match_truncated",
      "input": {
        "reported_total": 1200,
        "incomplete_results": false
      },
      "expect": { "truncated": true, "retrievable_limit": 1000 }
    },
    {
      "id": "list.title_match_incomplete",
      "input": {
        "reported_total": 4,
        "incomplete_results": true
      },
      "expect": { "incomplete": true }
    },
    {
      "id": "update.replace_labels",
      "input": {
        "before": ["docs", "custom"],
        "labels": ["personal"]
      },
      "expect": { "labels": ["personal"] }
    },
    {
      "id": "lifecycle.forget",
      "input": { "state": "active" },
      "expect": { "state": "forgotten" }
    },
    {
      "id": "lifecycle.reopen",
      "input": { "state": "forgotten" },
      "expect": { "state": "active" }
    },
    {
      "id": "mutation.ambiguous_transport_failure",
      "input": {
        "method": "POST",
        "request_body_sent": true,
        "response_received": false
      },
      "expect": { "error": "outcome_unknown", "retried": false }
    }
  ]
}
