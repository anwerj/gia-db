{
  "contract": "GiaDB",
  "version": "0.1.0",
  "scenarios": [
    {
      "id": "marker.recognized",
      "input": {
        "raw_body": "<!-- gia-db:v1 -->\nPrefer direct language."
      },
      "expect": {
        "kind": "resource",
        "body": "Prefer direct language."
      }
    },
    {
      "id": "marker.unmarked",
      "input": { "raw_body": "An ordinary issue" },
      "expect": { "kind": "non_resource" }
    },
    {
      "id": "marker.embedded_not_adopted",
      "input": { "raw_body": "notes\n<!-- gia-db:v1 -->\n" },
      "expect": { "kind": "non_resource" }
    },
    {
      "id": "marker.labels_do_not_identify",
      "input": {
        "raw_body": "An ordinary issue",
        "labels": ["bug", "docs"]
      },
      "expect": { "kind": "non_resource" }
    },
    {
      "id": "marker.noncanonical",
      "input": {
        "raw_bodies": [
          "<!-- gia-db:v1 -->",
          "<!-- gia-db:v1 -->\r\nhello",
          " <!-- gia-db:v1 -->\nhello",
          "<!-- gia-db:v2 -->\nhello",
          "<!--  gia-db:v1 -->\nhello"
        ]
      },
      "expect": {
        "kinds": [
          "non_resource",
          "non_resource",
          "non_resource",
          "non_resource",
          "non_resource"
        ]
      }
    },
    {
      "id": "marker.extract_exact",
      "input": {
        "raw_body": "<!-- gia-db:v1 -->\n# Title\n\nParagraph\n"
      },
      "expect": { "body": "# Title\n\nParagraph\n" }
    },
    {
      "id": "marker.extract_empty",
      "input": { "raw_body": "<!-- gia-db:v1 -->\n" },
      "expect": { "body": "" }
    },
    {
      "id": "marker.extract_json",
      "input": { "raw_body": "<!-- gia-db:v1 -->\n{\"ok\":true}" },
      "expect": { "body": "{\"ok\":true}" }
    },
    {
      "id": "marker.extract_embedded",
      "input": {
        "raw_body": "<!-- gia-db:v1 -->\nkeep <!-- gia-db:v1 --> inline"
      },
      "expect": { "body": "keep <!-- gia-db:v1 --> inline" }
    },
    {
      "id": "marker.update_preserves_one",
      "input": { "logical_body": "Updated body." },
      "expect": {
        "raw_body": "<!-- gia-db:v1 -->\nUpdated body.",
        "body": "Updated body.",
        "marker_count": 1
      }
    },
    {
      "id": "marker.update_embedded",
      "input": { "logical_body": "see <!-- gia-db:v1 --> later" },
      "expect": {
        "raw_body": "<!-- gia-db:v1 -->\nsee <!-- gia-db:v1 --> later",
        "body": "see <!-- gia-db:v1 --> later",
        "marker_count": 2
      }
    },
    {
      "id": "labels.keep_identity",
      "input": {
        "id": 21,
        "raw_body": "<!-- gia-db:v1 -->\nPrimary",
        "before": ["docs", "custom"],
        "labels": ["personal"]
      },
      "expect": {
        "id": 21,
        "raw_body": "<!-- gia-db:v1 -->\nPrimary",
        "body": "Primary",
        "labels": ["personal"]
      }
    },
    {
      "id": "mutation.unmarked_rejected",
      "input": { "raw_body": "ordinary", "operation": "update" },
      "expect": { "error": "not_found", "mutated": false }
    },
    {
      "id": "mutation.lost_marker",
      "input": {
        "id": 44,
        "accepted": true,
        "raw_body": "Updated body."
      },
      "expect": {
        "error": "invalid_resource",
        "outcome": "applied",
        "resource_id": 44
      }
    },
    {
      "id": "list.pull_request",
      "input": {
        "number": 7,
        "pull_request": {},
        "body": "<!-- gia-db:v1 -->\nnot a resource"
      },
      "expect": { "kind": "non_resource" }
    },
    {
      "id": "list.empty_filtered_page_continues",
      "input": {
        "items": [{ "number": 8, "body": "ordinary" }],
        "next_token": "opaque-next"
      },
      "expect": {
        "item_count": 0,
        "exhausted": false,
        "next_token": "opaque-next"
      }
    },
    {
      "id": "list.state_default",
      "input": {
        "resources": [
          { "id": 41, "state": "active" },
          { "id": 42, "state": "forgotten" }
        ]
      },
      "expect": { "ids": [41] }
    },
    {
      "id": "list.state_active",
      "input": {
        "state": "active",
        "resources": [
          { "id": 41, "state": "active" },
          { "id": 42, "state": "forgotten" }
        ]
      },
      "expect": { "ids": [41] }
    },
    {
      "id": "list.state_forgotten",
      "input": {
        "state": "forgotten",
        "resources": [
          { "id": 41, "state": "active" },
          { "id": 42, "state": "forgotten" }
        ]
      },
      "expect": { "ids": [42] }
    },
    {
      "id": "sections.are_separate",
      "input": { "resource": 12, "comment_count": 3 },
      "expect": { "resource_has_sections": false }
    },
    {
      "id": "list.title_match_truncated",
      "input": {
        "reported_total": 1200,
        "incomplete_results": false
      },
      "expect": { "truncated": true, "retrievable_limit": 1000 }
    },
    {
      "id": "list.title_match_incomplete",
      "input": {
        "reported_total": 4,
        "incomplete_results": true
      },
      "expect": { "incomplete": true }
    },
    {
      "id": "update.replace_labels",
      "input": {
        "before": ["docs", "custom"],
        "labels": ["personal"]
      },
      "expect": { "labels": ["personal"] }
    },
    {
      "id": "lifecycle.forget",
      "input": { "state": "active" },
      "expect": { "state": "forgotten" }
    },
    {
      "id": "lifecycle.reopen",
      "input": { "state": "forgotten" },
      "expect": { "state": "active" }
    },
    {
      "id": "mutation.ambiguous_transport_failure",
      "input": {
        "method": "POST",
        "request_body_sent": true,
        "response_received": false
      },
      "expect": { "error": "outcome_unknown", "retried": false }
    }
  ]
}
